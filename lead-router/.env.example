# RAM Lead Router — environment variables
# Copy to .env.local for local runs; set the same keys in Vercel project
# settings for the deployed function. Never commit real values.

# --- Required: webhook authentication -------------------------------------
# Shared secret Vapi sends on every request to the Server URL. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The endpoint fails closed (500) until this is set.
VAPI_WEBHOOK_SECRET=

# Header the secret arrives in. Default 'authorization' matches the Vapi Bearer
# Token credential. Only change it if the credential uses a custom header.
# VAPI_WEBHOOK_SECRET_HEADER=authorization

# --- Required: email delivery (Resend) ------------------------------------
RESEND_API_KEY=
# Verified sender. "RAM Lead Router <leads@ram-strategicsystems.com>" or a bare
# address. For a first smoke test before domain verification, Resend allows
# onboarding@resend.dev to your own account address.
LEAD_FROM_EMAIL=

# Where leads go. Comma-separated. Defaults to contact@ram-strategicsystems.com.
# LEAD_NOTIFICATION_EMAIL=contact@ram-strategicsystems.com

# --- Strongly recommended: structured-output fallback ----------------------
# Vapi private API key. Without it, calls whose structured output isn't ready
# when end-of-call-report fires produce no lead email.
VAPI_API_KEY=
# VAPI_API_BASE=https://api.vapi.ai
# Backoff before each re-read, ms. 'off' disables re-fetching entirely.
# These are tuning choices, not Vapi guarantees — adjust from real call logs.
# STRUCTURED_OUTPUT_POLL_DELAYS_MS=3000,5000
# Hard ceiling on total resolution time, ms. Keeps the request inside Vapi's
# webhook timeout and the function's maxDuration (30s).
# STRUCTURED_OUTPUT_BUDGET_MS=15000

# --- Optional: client configuration ---------------------------------------
# Pin the demo assistant's id. Required only once a second client exists.
# DOOR4LIFE_ASSISTANT_IDS=
# DOOR4LIFE_ENABLED=true
# DOOR4LIFE_NOTIFICATION_RECIPIENTS=

# --- Optional: logging -----------------------------------------------------
# debug | info | warn | error. Keep at info or higher in production.
# LOG_LEVEL=info
